<?xml version="1.0" encoding="utf-8"?>
<!-- Frost tint over the wallpaper wash, with a bright hairline along the top edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="270" android:startColor="#40FFFFFF" android:endColor="#00FFFFFF" android:centerColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:left="0.8dp" android:top="0.8dp" android:right="0.8dp" android:bottom="0.8dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#B32B2B2D" />
        </shape>
    </item>
</layer-list>
